# Copy to .env (never commit .env). Values below are DEVELOPMENT placeholders only.
ASVAS_ENV=development
ASVAS_DATABASE_URL=postgresql+psycopg://asvas_app:asvas_app_dev@localhost:5432/asvas
ASVAS_MIGRATION_DATABASE_URL=postgresql+psycopg://asvas_owner:asvas_owner_dev@localhost:5432/asvas
ASVAS_REDIS_URL=redis://localhost:6379/0
ASVAS_OPA_URL=http://127.0.0.1:8181
# Generate real secrets with: python3 -c "import secrets;print(secrets.token_hex(32))"
ASVAS_JWT_SECRET=dev-only-change-me
# Shared between control plane and executor (HMAC for envelopes, approvals, results, control messages).
ASVAS_SIGNING_KEY=dev-only-change-me
# deterministic-test (NOT an AI assessment) | anthropic
ASVAS_MODEL_PROVIDER=deterministic-test
ASVAS_MODEL_NAME=claude-sonnet-4-5
# ASVAS_ANTHROPIC_API_KEY=   (server-side only; never in the dashboard)
# Needed only for the bundled local test target on 127.0.0.1. Refused when ASVAS_ENV=production.
ASVAS_ALLOW_LOOPBACK_TARGETS=true
# Executor
ASVAS_POLICY_DIR=policies
ASVAS_EXECUTION_BACKEND=devprocess
ASVAS_EXECUTOR_SLOTS=4
# Graph projection (optional; PostgreSQL is the source of truth). Leave URI empty to disable.
ASVAS_NEO4J_URI=bolt://127.0.0.1:7687
ASVAS_NEO4J_USER=neo4j
ASVAS_NEO4J_PASSWORD=asvas_neo4j_dev
# Mutual TLS for the executor's gRPC ExecutorService (generate dev material with scripts/dev-certs.sh).
# Executor (server) side:
ASVAS_TLS_CA=var/certs/ca.crt
ASVAS_TLS_CERT=var/certs/executor.crt
ASVAS_TLS_KEY=var/certs/executor.key
ASVAS_GRPC_ADDR=127.0.0.1:7443
# Control plane (client) side:
ASVAS_EXECUTOR_TLS_CA=var/certs/ca.crt
ASVAS_EXECUTOR_TLS_CERT=var/certs/control-plane.crt
ASVAS_EXECUTOR_TLS_KEY=var/certs/control-plane.key
